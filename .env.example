PLAY_PACKAGE_NAME=com.seu.app
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# Path to the local DuckDB database file (default: play_insights.duckdb)
DB_PATH=play_insights.duckdb
TIMEZONE=America/Sao_Paulo
LOG_LEVEL=INFO
REPLY_PUBLISH_ENABLED=false
# Required only when REPLY_PUBLISH_ENABLED=true
REPLY_PUBLISH_APPROVAL_TOKEN=

# Optional: needed only for install metrics from Play Console BQ export
# pip install play-insights[stats]  to enable
# GCP_PROJECT_ID=your-gcp-project-id
# PLAY_BQ_EXPORT_DATASET=
